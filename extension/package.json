{
  "name": "translate-bot-extension",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.content.config.ts && vite build && node scripts/postbuild.mjs",
    "dev": "vite build --config vite.content.config.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.1",
    "hangul-romanization": "^1.0.1"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.48.0"
  }
}
